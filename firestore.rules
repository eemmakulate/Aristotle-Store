rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can view the catalog (needed for the customer
    // product list). Only a signed-in owner (Firebase Auth session,
    // via the email-link login) can add, edit, or delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers: readable so the app can check a username/password on
    // login, and so the owner's dashboard can list them. Only a signed-in
    // owner can create or delete customer accounts. Anyone can update a
    // customer document — this is what lets the app's own password-reset
    // and first-login-reset screens work without the owner being involved.
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Orders: customers create and read their own orders; the owner
    // (signed in) can read and update all of them to mark paid/unpaid.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
  }
}
